#!/bin/bash

set -euo pipefail
. /.functions

#
# Init all the SSL-related stuff
#
init_ssl

#
# Append SSL-related options for ActiveMQ, consumed
# directly by the configuration files (no more need
# to edit them using xmlstarlet)
#
set_or_default ACTIVEMQ_OPTS
if [ -n "${JAVAX_NET_SSL_OPTIONS}" ] ; then
	[ -n "${ACTIVEMQ_OPTS}" ] && ACTIVEMQ_OPTS+=" "
	ACTIVEMQ_OPTS+="${JAVAX_NET_SSL_OPTIONS}"
fi
export ACTIVEMQ_OPTS

#
# Onward, Bucephalus!
#
execute "${AMQ_HOME}/init.sh" "${AMQ_HOME}"
